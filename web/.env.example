# Turso: `turso db show <name> --url` and `turso db tokens create <name>`.
# Locally, file:local.db needs no token.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=
# Any long random string: `openssl rand -base64 32`
SESSION_SECRET=
# Who can open /analytics (comma-separated Google emails).
ADMIN_EMAILS=
# Email sign-in codes via Brevo (free: 300/day). EMAIL_FROM must be a verified
# sender in Brevo. Without a key, local dev prints codes to the server log.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Ayok Ngaji
